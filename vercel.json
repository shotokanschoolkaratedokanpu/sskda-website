{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "image-assets/**",
          "uploads/**",
          "*.html",
          "*.json",
          "node_modules/**",
          "public/**",
          "*.png",
          "*.jpg",
          "*.jpeg"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}